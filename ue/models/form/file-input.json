          "label": "Maximum file size error message",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "accept",
          "label": "Allowed file types",
          "valueType": "string",
          "multi": true,
          "value": [
            "audio/*",
            "video/*",
            "image/*",
            "text/*",
            "application/pdf"
          ]
        },
        {
          "component": "text",
          "name": "constraintMessages.accept",
          "label": "File type error message",
          "valueType": "string"
        },
        {
          "component": "tab",
          "label": "Help Content",
          "name": "help"
