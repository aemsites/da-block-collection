          "label": "Name",
          "valueType": "string",
          "required": true,
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^[^$].*",
            "customErrorMsg": "Name cannot start with $"
          }
        },
        {
          "component": "text",
          "name": "label.value",
          "label": "Title",
          "valueType": "string",
