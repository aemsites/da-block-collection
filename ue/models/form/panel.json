{
  "definitions": [
    {
      "title": "Panel",
      "id": "panel",
      "model": "panel",
      "filter": "form-fields",
      "plugins": {
        "da": {
          "type": "key-value-block"
        }
      }
    }
  ],
  "models": [
    {
      "id": "panel",
      "fields": [
        {
          "component": "tab",
          "label": "Basic",
          "name": "basic"
        },
        {
          "component": "text",
          "name": "name",
          "label": "Name",
          "valueType": "string",
          "required": true,
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^[^$].*",
            "customErrorMsg": "Name cannot start with $"
          }
        },
        {
          "component": "text",
          "name": "label.value",
          "label": "Title",
          "valueType": "string",
          "value": "Panel"
        },
        {
          "component": "boolean",
          "name": "properties.hideTitle",
          "label": "Hide title",
          "valueType": "boolean"
        },
        {
          "component": "text",
          "name": "dataRef",
          "label": "Bind reference",
          "valueType": "string"
        },
        {
          "component": "boolean",
          "name": "properties.unboundFormElement",
          "label": "Mark as Unbound Form Element",
          "valueType": "boolean"
        },
        {
          "component": "boolean",
          "name": "visible",
          "label": "Show Component",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "boolean",
          "name": "enabled",
          "label": "Enable Component",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "boolean",
          "name": "readOnly",
          "label": "Read-only",
          "valueType": "boolean"
        },
        {
          "component": "select",
          "name": "properties.colspan",
          "label": "Column Span",
          "valueType": "string",
          "value": "12",
          "options": [
            {
              "name": "1 column",
              "value": "1"
            },
            {
              "name": "2 column",
              "value": "2"
            },
            {
              "name": "3 column",
              "value": "3"
            },
            {
              "name": "4 column",
              "value": "4"
            },
            {
              "name": "5 column",
              "value": "5"
            },
            {
              "name": "6 column",
              "value": "6"
            },
            {
              "name": "7 column",
              "value": "7"
            },
            {
              "name": "8 column",
              "value": "8"
            },
            {
              "name": "9 column",
              "value": "9"
            },
            {
              "name": "10 column",
              "value": "10"
            },
            {
              "name": "11 column",
              "value": "11"
            },
            {
              "name": "12 column",
              "value": "12"
            }
          ]
        },
        {
          "component": "tab",
          "label": "Repeat Panel",
          "name": "repeat"
        },
        {
          "component": "boolean",
          "name": "properties.repeatable",
          "label": "Make panel repeatable",
          "valueType": "boolean"
        },
        {
          "component": "number",
          "name": "minOccur",
          "label": "Minimum repetitions",
          "valueType": "number",
          "description": "Minimum number of times the panel appears on the form",
          "condition": {
            "===": [
              {
                "var": "properties.repeatable"
              },
              true
            ]
          },
          "value": 1
        },
        {
          "component": "number",
          "name": "maxOccur",
          "label": "Maximum repetitions",
          "valueType": "number",
          "placeholder": "No Limit",
          "description": "Maximum number of times the panel can appear on the form. No value indicates no limit.",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "properties.repeatable"
                  },
                  true
                ]
              },
              {
                "!==": [
                  {
                    "var": "properties.variant"
                  },
                  "noButtons"
                ]
              }
            ]
          }
        },
        {
          "component": "select",
          "name": "properties.variant",
          "label": "Variant",
          "options": [
            {
              "name": "No Actions",
              "value": "noButtons"
            },
            {
              "name": "Add & Delete Buttons",
              "value": "addDeleteButtons"
            }
          ],
          "value": "addDeleteButtons",
          "condition": {
            "===": [
              {
                "var": "properties.repeatable"
              },
              true
            ]
          }
        },
        {
          "component": "text",
          "name": "properties.repeatAddButtonLabel",
          "label": "Add Button Label",
          "valueType": "string",
          "value": "Add",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "properties.variant"
                  },
                  "addDeleteButtons"
                ]
              },
              {
                "===": [
                  {
                    "var": "properties.repeatable"
                  },
                  true
                ]
              }
            ]
          }
        },
        {
          "component": "text",
          "name": "properties.repeatDeleteButtonLabel",
          "label": "Delete Button Label",
          "valueType": "string",
          "value": "Delete",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "properties.variant"
                  },
                  "addDeleteButtons"
                ]
              },
              {
                "===": [
                  {
                    "var": "properties.repeatable"
                  },
                  true
                ]
              }
            ]
          }
        },
        {
          "component": "tab",
          "label": "Help Content",
          "name": "help"
        },
        {
          "component": "richtext",
          "name": "description",
          "label": "Help text",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "tooltip",
          "label": "Short description",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "fieldType",
          "label": "fieldType",
          "valueType": "string",
          "value": "panel",
          "condition": {
            "===": [
              1,
              0
            ]
          }
        }
      ]
    }
  ],
  "filters": []
}
